{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Marketing App",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "corepack pnpm --filter @knoxumi/marketing dev",
      "serverReadyAction": {
        "pattern": "- Local:\\s+https?://localhost:([0-9]{2,5})",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run Waiver App",
      "type": "node-terminal",
      "request": "launch",
