{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Marketing App",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "corepack pnpm --filter @knoxumi/marketing dev",
      "serverReadyAction": {
        "pattern": "- Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run Waiver App",
